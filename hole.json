    "/about": {
      "title": "1 About/",
      "copy": [
        "GOPHER AI is a standalone phone assistant you pay for. You talk to a number. It turns the talk into an order, fetches, and brings the answer back to the same thread.",
        "The name is the point. Old Gopher was a menu, a selector, a fetch. No infinite scroll. No chat sludge. A modern prompt sits on that contract."
      ]
    },
    "/how": {
      "title": "2 How it works/",
      "steps": [
        "You send an order \u2014 voice, SMS, or the prompt.",
        "GOPHER AI files it as a selector: fetch, watch, draft, remind.",
        "Plugins you connect do the work.",
        "The result comes back to the same conversation."
      ]
    },
    "/caps": {
      "title": "3 Capabilities/",
      "caps": [
        "Voice and SMS in. A reply out.",
        "Orders, not chat.",
        "Numbered menus + a modern ask box.",
        "FETCH, an original 8-bit hole.",
        "A log of what was asked and what came back."
      ],
      "note": "Not a general chatbot. Not a free public menu."
    },
    "/privacy": {
      "title": "4 Privacy",
      "copy": "We keep your waitlist email now; later, your number and order logs to do the job. Login on this page stays on this device. We don\u2019t sell any of it."
    }
